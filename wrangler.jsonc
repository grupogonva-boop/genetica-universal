{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genetica-universal-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "admin.geneticauniversal.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "genetica-universal-admin", "database_id": "3c0546f8-99d8-4b26-bd49-409d9c3da2c6", "migrations_dir": "worker/migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "genetica-universal-media" }
  ],
  "vars": {
    "ADMIN_EMAIL": "grupo.gonva@gmail.com",
    "PUBLIC_ORIGINS": "https://geneticauniversal.com,https://www.geneticauniversal.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
